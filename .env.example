PORT=3000

# Conexão com banco de dados na nuvem (PostgreSQL - Neon, Supabase, Vercel Postgres, Railway)
# Se preenchido, o app usa PostgreSQL. Se vazio, o app usa SQLite local automaticamente.
DATABASE_URL=

# Caminho do banco SQLite local (usado apenas se DATABASE_URL estiver vazio)
DATABASE_PATH=./database.sqlite

# Segredo para assinatura de sessão (cookies)
SESSION_SECRET=

# Credenciais da conta Master inicial
MASTER_EMAIL=master@empresa.com
MASTER_PASSWORD=
