{
  "version": 2,
  "buildCommand": "npm run check",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "env": [
    "TURSO_DATABASE_URL",
    "TURSO_AUTH_TOKEN",
    "SESSION_SECRET",
    "MASTER_PASSWORD",
    "MASTER_EMAIL",
    "NODE_ENV"
  ]
}
